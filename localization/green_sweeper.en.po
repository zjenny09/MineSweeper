msgstr "Pollution source moved with the current · All numbers updated · %d cells remain"

msgid "洋流倒计时 · 再净化%d格，未锚定污染将向下游漂移"
msgstr "Current Countdown · Clear %d more cells before unanchored pollution drifts downstream"

msgid "洋流已推动%d个污染核心 · 数字已重新计算 · 距下次%d格"
msgstr "Current moved %d Pollution Cores · Numbers recalculated · %d cells until next move"

msgid "洋流已激活 · 再净化%d格，未锚定污染将向下游漂移"
msgstr "Current Active · Clear %d more cells before unanchored pollution drifts downstream"

msgid "洋流涌动 · 未锚定污染正在向下游漂移"
msgstr "Current Surging · Unanchored pollution is drifting downstream"

msgid "洋流涌动完成 · 污染已被标记锚定 · 距下次%d格"
msgstr "Current Surge Complete · Pollution anchored by flags · %d cells until next move"

msgid "漂流污染源%d秒后移动"
msgstr "Drifting source moves in %d seconds"

msgid "漂流污染源启动 · %d秒后向过滤边界移动 · 剩余%d格"
msgstr "Drifting source started · Moves toward the filter in %d seconds · %d cells remain"

msgid "漂流污染源已净化 · 停止向过滤边界漂移"
msgstr "Drifting source purified · Movement toward the filter stopped"

msgid "漂流污染源未及时净化并流出边界 · 本次净化失败"
msgstr "The drifting source crossed the boundary before purification · Mission failed"

msgid "漂流航线底格不会生成静态水雷，无需标记"
msgstr "Cells beneath the drift route never contain static mines and need no flags"

msgid "潮区%d尚未完成 · 仍有%d个安全格未翻开"
msgstr "Tidal Zone %d incomplete · %d safe cells remain hidden"

msgid "潮区%d尚未完成 · 仍有%d个安全格未翻开，其中%d个被错误标记"
msgstr "Tidal Zone %d incomplete · %d safe cells remain hidden, including %d wrongly flagged"

msgid "白色=未净化 · 黄色=安全建议"
msgstr "White = Hidden · Yellow = Safe Suggestion"

msgid "种子放错会阻止数字快速展开"
msgstr "A misplaced seed blocks quick number expansion"

msgid "移动到这里按 J 翻开"
msgstr "Move here and press J to reveal"

msgid "移动后按 J 再翻一格"
msgstr "Move, then press J to reveal another cell"

